{
  "entities": {
    "LicenseAccount": {
      "title": "LicenseAccount",
      "description": "User account and software license state for PAAS WIVER desktop and mobile admin apps.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID matching document ID."
        },
        "username": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "description": "Unique login username for PAAS WIVER."
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "Account role."
        },
        "status": {
          "type": "string",
          "enum": ["trial", "active", "expired"],
          "description": "Current license status."
        },
        "trialGranted": {
          "type": "boolean",
          "description": "Whether the initial 10-minute free trial was granted."
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "UTC timestamp when this user's license or free trial expires."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last license or heartbeat update."
        }
      },
      "required": [
        "uid",
        "ownerUid",
        "username",
        "role",
        "status",
        "trialGranted",
        "expiresAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Registered administrator UID marker.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "Startup Firestore connectivity probe document.",
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        }
      },
      "required": ["ok"]
    }
  },
  "firestore": {
    "/licenses/{userId}": {
      "schema": { "$ref": "#/entities/LicenseAccount" },
      "description": "Per-user license records with server-enforced trial cap and admin-only extensions."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin role lookup documents."
    },
    "/test/{docId}": {
      "schema": { "$ref": "#/entities/ConnectionTest" },
      "description": "Connectivity probe path."
    }
  }
}
